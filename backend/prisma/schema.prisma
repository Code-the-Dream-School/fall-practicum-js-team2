generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int      @id @default(autoincrement())
  email          String   @unique @db.VarChar(255)
  name           String   @db.VarChar(30)
  hashedPassword String   @db.VarChar(255) @map("hashed_password") // Mapped
  createdAt      DateTime @default(now()) @db.Timestamp(6) @map("created_at") // Mapped
  gamesPlayed    Game[]  

  @@map("users")
}

// Game rules
model Game { 
  id             Int       @id @default(autoincrement()) 
  pictionaryWord String    @map("pictionary_word") @db.VarChar(50)
  status         String    @default("active") @db.VarChar(20)
  startDate      DateTime  @default(now()) @map("start_date)
  endDate        DateTime  @map("end_date)
  
  @@map("games")
}

// What each user can do
model Participant {
   id            Int       @id @default(autoincrement())
   userId        Int       @map("user_id")
   gameId        Int       @map("game_id")
   score         Int       @default(0)
   isDrawing     Boolean   @default(false) @map("is_drawing")
   
   @@map("participants")
} 

