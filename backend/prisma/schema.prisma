generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int      @id @default(autoincrement())
  email              String   @unique @db.VarChar(255)
  name               String   @db.VarChar(30)
  hashedPassword     String   @db.VarChar(255) @map("hashed_password") // Mapped
  createdAt          DateTime @default(now()) @db.Timestamp(6) @map("created_at") // Mapped
  participated       Participant[] // Play history of games and votes 

  @@map("users")
}

// Game rules
model Game { 
  id                 Int       @id @default(autoincrement()) 
  pictionaryWord     String    @map("pictionary_word") @db.VarChar(50)
  status             String    @default("active") @db.VarChar(20)
  startDate          DateTime  @default(now()) @map("start_date")
  endDate            DateTime  @map("end_date")
  participants       Participant[] 

  @@map("games")
}

// What each user can do
model Participant {
   id                Int       @id @default(autoincrement())
   userId            Int       @map("user_id")
   gameId            Int       @map("game_id")
   score             Int       @default(0)
   isDrawing         Boolean   @default(false) @map("is_drawing")
   
   user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
   game              Game      @relation(fields: [gameId], references: [id], onDelete: Cascade) 

   drawings          Drawing[]
   voted             Vote[]    @relation("VoterRelation")
   received          Vote[]    @relation("TargetRelation")

   @@unique([userId, gameId], name: "userGame", map: "user_id_game_id_unique")
   @@map("participants")
} 

// @TODO need to figure out how to save track gps path here
model Drawing {
   id                 Int       @id @default(autoincrement()) 
   participantId      Int       @map("participant_id")
   submittedAt        DateTime  @default(now()) @db.Timestamp(6) @map("submitted_at")

   participant        Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
 
   @@map("drawings")
}

model Vote {
    id                Int       @id @default(autoincrement())
    voterParticipant  Int       @map("voter_participant")
    targetParticipant Int       @map("target_participant")
    createdAt         DateTime  @default(now()) @db.Timestamp(6) @map("created_at")

    voter             Participant @relation("VoterRelation", fields: [voterParticipant], references: [id], onDelete: Cascade)
    target            Participant @relation("TargetRelation", fields: [targetParticipant], references: [id], onDelete: Cascade)

    @@unique([voterParticipant, targetParticipant], name: "uniqueVotePerDrawing")
    @@map("votes")
}

// The pictionary word
model Word {
    id                Int       @id @default(autoincrement()) 
    text              String    @unique @db.VarChar(50)
    difficulty        String    @default("easy") @db.VarChar(50)
    createdAt         DateTime  @default(now()) @db.Timestamp(6) @map("created_at")

    @@map("words")
}