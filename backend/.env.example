PORT=8080

# Secret used to sign login tokens (JWT). Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Neon development branch, pooled connection string (Notice the -pooler)
DATABASE_URL=postgresql://user:password@host-pooler.neon.tech/neondb?sslmode=require

# Same Neon development branch, direct connection string (No -pooler)
DIRECT_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require